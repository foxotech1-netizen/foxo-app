NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=FoxO <noreply@send.foxo.be>

SUPABASE_AUTH_HOOK_SECRET=

SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

NEXT_PUBLIC_APP_URL=
# URL publique du portail partenaire (liens dans les mails)
NEXT_PUBLIC_PORTAL_URL=

# Cron Vercel (rappel J-1) — Vercel injecte ce token dans Authorization
# Bearer pour les jobs définis dans vercel.json
CRON_SECRET=

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Google OAuth (Drive + Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_RAPPORTS_FOLDER_ID=
GOOGLE_DRIVE_FACTURES_FOLDER_ID=
# Jeton vérifié sur les notifications push de Google Calendar (webhook)
GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Odoo (import historique / coexistence comptable)
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=

# Storecove (facturation électronique Peppol)
STORECOVE_API_KEY=
STORECOVE_LEGAL_ENTITY_ID=

# Ponto (relevés bancaires)
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=

# Optionnel : journalisation détaillée du cron check-mails (mettre 1 pour activer)
CHECK_MAILS_VERBOSE=
